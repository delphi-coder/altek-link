#include <windows.h>
#include "../include/build_number.h"
#define ALTEK_STR_INNER(x) #x
#define ALTEK_STR(x) ALTEK_STR_INNER(x)
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION 0,2,0,APP_BUILD
 PRODUCTVERSION 0,2,0,APP_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ALTEK\0"
            VALUE "FileDescription", "ALTEK Link\0"
            VALUE "FileVersion", "0.2.0." ALTEK_STR(APP_BUILD) "\0"
            VALUE "InternalName", "AltekLink\0"
            VALUE "OriginalFilename", "AltekLink.exe\0"
            VALUE "ProductName", "ALTEK Link\0"
            VALUE "ProductVersion", "0.2.0." ALTEK_STR(APP_BUILD) "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
